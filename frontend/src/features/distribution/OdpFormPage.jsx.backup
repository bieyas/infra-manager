import React, { useState, useEffect, useMemo } from 'react'
import { useNavigate, useParams } from 'react-router-dom'
import { ArrowLeft, Loader2, AlertCircle, MapPin, Save, Wand2, Trash2 } from 'lucide-react'
import Button from '../../components/ui/Button'
import LocationPickerModal from '../../components/ui/LocationPickerModal'
import ConfirmModal from '../../components/ui/ConfirmModal'
import CoreSelect from './CoreSelect'
import PhotoUpload from './PhotoUpload'
import SplitterManager from './SplitterManager'
import { SPLITTER_OPTIONS, MOUNT_OPTIONS,
  useOdpList, useOdpDetail, useOdcList,
  createOdp, updateOdp, deleteOdp,
} from './useDistribution'
import { useDevices } from '../devices/useDevices'
import { useToast } from '../../context/ToastContext'
import { useAppSettings } from '../../hooks/useAppSettings'
import { suggestOdpName, getPonList } from './formHelpers'

const IC = 'w-full px-3 py-2 text-sm rounded-lg border border-[var(--border)] bg-[var(--bg-secondary)] text-primary placeholder:text-muted focus:outline-none focus:border-[var(--accent)] transition-colors'

function Section({ title, children }) {
  return (
    <div className="card p-5 space-y-4">
      <p className="text-xs font-semibold text-muted uppercase tracking-wider border-b border-[var(--border)] pb-2">{title}</p>
      {children}
    </div>
  )
}
function Field({ label, hint, children, required }) {
  return (
    <div>
      <label className="block text-xs font-medium text-secondary mb-1.5">
        {label}{required && <span className="text-rose-400 ml-0.5">*</span>}
      </label>
      {children}
      {hint && <p className="text-[10px] text-muted mt-1">{hint}</p>}
    </div>
  )
}

const getEmptyState = (settings) => ({
  name: '', address: '', lat: '', lng: '',
  uplinkType: 'odc', // 'odc' | 'odp'
  odcId: '', oltId: '', ponPort: '',
  uplinkOdpId: '', uplinkOdpCore: '',
  feederLabel: '', feederCore: '',
  // NEW: Multi-splitter system
  splitters: [],
  inputPower: null,
  // Legacy fields
  splitterRatio: settings?.defaultOdpSplitter ?? 'R1_8',
  mountType: settings?.defaultMountType ?? '',
  brand: '', status: 'ACTIVE',
  installDate: '', pic: '', notes: '', photos: [],
})

export default function OdpFormPage() {
  const { id } = useParams()
  const navigate = useNavigate()
  const isEdit = Boolean(id)
  const toast = useToast()
  const { settings } = useAppSettings()

  const { devices } = useDevices()
  const olts = useMemo(() => devices.filter(d => d.type === 'olt' || d.type === 'OLT'), [devices])
  const { odcs } = useOdcList({})
  const { odps: allOdps } = useOdpList({})
  const { odp, loading: loadingOdp } = useOdpDetail(isEdit ? id : null)

  const [form,    setForm]    = useState(() => getEmptyState(settings))
  const [saving,  setSaving]  = useState(false)
  const [error,   setError]   = useState('')
  const [mapOpen, setMapOpen] = useState(false)
  const [confirmOpen, setConfirmOpen] = useState(false)
  const [confirmMode, setConfirmMode] = useState('save') // 'save' | 'delete'
  const [pendingPayload, setPendingPayload] = useState(null)

  // Reset form dengan default baru jika settings berubah (tambah mode)
  useEffect(() => {
    if (!isEdit) {
      setForm(f => ({ 
        ...f, 
        splitterRatio: settings?.defaultOdpSplitter ?? 'R1_8', 
        mountType: settings?.defaultMountType ?? '',
        splitters: [],
        inputPower: null,
      }))
    }
  }, [settings.defaultOdpSplitter, settings.defaultMountType, isEdit])

  // Derive PON list from ODC's parent OLT ponCount (or selected OLT)
  const selectedOlt = useMemo(() => {
    const oltId = form.oltId || odcs.find(o => o.id === form.odcId)?.oltId
    return olts.find(o => o.id === oltId) ?? null
  }, [olts, odcs, form.oltId, form.odcId])

  const ponList = useMemo(() => getPonList(selectedOlt), [selectedOlt])
  const existingNames = useMemo(() => allOdps.filter(o => o.id !== id).map(o => o.name), [allOdps, id])
  const selectedOdc = useMemo(() => odcs.find(o => o.id === form.odcId) ?? null, [odcs, form.odcId])

  useEffect(() => {
    if (isEdit && odp) {
      // Auto-migrate legacy splitterRatio to new splitters array if empty
      let migratedSplitters = odp.splitters ?? []
      if (migratedSplitters.length === 0 && odp.splitterRatio) {
        // Parse ratio like "R1_8" to get output count (8)
        const ratioMatch = odp.splitterRatio.match(/R1_(\d+)/)
        const outputCount = ratioMatch ? parseInt(ratioMatch[1]) : 8
        const ratioLabel = ratioMatch ? `1:${ratioMatch[1]}` : '1:8'
        
        migratedSplitters = [{
          id: `legacy-${Date.now()}`,
          splitterTypeId: odp.splitterRatio,
          category: 'SYMMETRIC',
          sequenceOrder: 1,
          position: 'Slot A',
          portMappings: [],
          inputPower: null,
          outputs: outputCount,
          type: {
            id: odp.splitterRatio,
            code: odp.splitterRatio,
            name: `PLC ${ratioLabel}`,
            category: 'SYMMETRIC',
            outputCount: outputCount,
            attEqual: parseFloat((3.5 + 10 * Math.log10(outputCount)).toFixed(1))
          }
        }]
      }
      
      setForm({
        name:          odp.name          ?? '',
        address:       odp.address       ?? '',
        lat:           odp.lat           ?? '',
        lng:           odp.lng           ?? '',
        uplinkType:    odp.uplinkType    ?? 'odc',
        odcId:         odp.odcId         ?? '',
        oltId:         odp.oltId         ?? '',
        ponPort:       odp.ponPort       ?? '',
        uplinkOdpId:   odp.uplinkOdpId   ?? '',
        uplinkOdpCore: odp.uplinkOdpCore ?? '',
        feederLabel:   odp.feederLabel   ?? '',
        feederCore:    odp.feederCore    ?? '',
        splitterRatio: odp.splitterRatio ?? 'R1_8',
        mountType:     odp.mountType     ?? '',
        brand:         odp.brand         ?? '',
        status:        odp.status        ?? 'ACTIVE',
        installDate:   odp.installDate ? odp.installDate.slice(0, 10) : '',
        pic:           odp.pic           ?? '',
        notes:         odp.notes         ?? '',
        photos:        odp.photos        ?? [],
        // NEW: Multi-splitter fields from API (or migrated from legacy)
        splitters:     migratedSplitters,
        inputPower:    odp.inputPower    ?? null,
      })
    }
  }, [isEdit, odp])

  const set = (k, v) => setForm(f => ({ ...f, [k]: v }))

  // Uplink type change
  const handleUplinkTypeChange = (type) => {
    setForm(f => ({
      ...f,
      uplinkType: type,
      odcId: '', oltId: '', ponPort: '',
      uplinkOdpId: '', uplinkOdpCore: '',
    }))
  }

  // ODC change → inherit OLT/PON, re-suggest name
  const handleOdcChange = (odcId) => {
    const odc = odcs.find(o => o.id === odcId)
    setForm(f => ({
      ...f,
      odcId,
      oltId:   odc?.oltId   ?? f.oltId,
      ponPort: odc?.ponPort ?? f.ponPort,
      name: !isEdit
        ? suggestOdpName({ odcName: odc?.name, existingNames })
        : f.name,
    }))
  }

  // Uplink ODP change → inherit OLT/PON from ODP upstream
  const handleUplinkOdpChange = (odpId) => {
    const uplinkOdp = allOdps.find(o => o.id === odpId)
    setForm(f => ({
      ...f,
      uplinkOdpId: odpId,
      uplinkOdpCore: '',
      // Auto-inherit OLT and PON from upstream ODP (disabled in UI)
      oltId: uplinkOdp?.oltId ?? '',
      ponPort: uplinkOdp?.ponPort ?? '',
      name: !isEdit
        ? suggestOdpName({ odcName: uplinkOdp?.name, existingNames })
        : f.name,
    }))
  }

  // Manual generate name
  const handleSuggestName = () => {
    const upstreamName = form.uplinkType === 'odc' ? selectedOdc?.name : allOdps.find(o => o.id === form.uplinkOdpId)?.name
    set('name', suggestOdpName({ odcName: upstreamName, existingNames }))
  }

  // Real-time update saat marker digeser / klik peta / GPS
  const handlePositionChange = ({ lat, lng }) => setForm(f => ({ ...f, lat, lng }))

  // Reverse geocode → selalu update alamat ke hasil terbaru
  const handleAddressResolved = (address) => setForm(f => ({ ...f, address }))

  const handleSubmit = (e) => {
    e.preventDefault()
    setConfirmMode('save')
    
    // Derive legacy splitterRatio from first splitter if exists
    const firstSplitter = form.splitters?.[0]
    const derivedSplitterRatio = firstSplitter 
      ? `R1_${firstSplitter.type?.outputCount || firstSplitter.outputs || 8}`
      : form.splitterRatio
    
    const payload = {
      ...form,
      lat:         form.lat !== '' ? Number(form.lat) : null,
      lng:         form.lng !== '' ? Number(form.lng) : null,
      odcId:       form.uplinkType === 'odc' ? (form.odcId || null) : null,
      oltId:       form.oltId   || null,
      ponPort:     form.ponPort || null,
      uplinkOdpId: form.uplinkType === 'odp' ? (form.uplinkOdpId || null) : null,
      uplinkOdpCore: form.uplinkType === 'odp' ? (form.uplinkOdpCore || null) : null,
      installDate: form.installDate || null,
      photos:      form.photos?.length ? form.photos : null,
      // NEW: Multi-splitter fields
      splitters:   form.splitters?.length ? form.splitters : null,
      inputPower:  form.inputPower !== '' ? (form.inputPower !== null ? Number(form.inputPower) : null) : null,
      // Legacy: derive from new splitters
      splitterRatio: derivedSplitterRatio,
    }
    setPendingPayload(payload)
    setConfirmOpen(true)
  }

  const handleConfirmSubmit = async () => {
    if (!pendingPayload) return
    setConfirmOpen(false)
    setSaving(true)
    setError('')
    try {
      if (isEdit) {
        await updateOdp(id, pendingPayload)
        toast.success(`ODP "${pendingPayload.name}" berhasil diperbarui`)
      } else {
        await createOdp(pendingPayload)
        toast.success(`ODP "${pendingPayload.name}" berhasil ditambahkan`)
      }
      navigate('/odp')
    } catch (e) {
      const msg = e.message ?? 'Gagal menyimpan'
      setError(msg)
      toast.error(msg)
    } finally {
      setSaving(false)
      setPendingPayload(null)
    }
  }

  const handleDeleteClick = () => {
    setConfirmMode('delete')
    setConfirmOpen(true)
  }

  const handleConfirmDelete = async () => {
    if (!id) return
    setConfirmOpen(false)
    try {
      await deleteOdp(id)
      toast.success(`ODP berhasil dihapus`)
      navigate('/odp')
    } catch (e) {
      const msg = e.message ?? 'Gagal menghapus'
      toast.error(msg)
    }
  }

  if (isEdit && loadingOdp) {
    return (
      <div className="flex items-center justify-center py-24 text-muted gap-3">
        <Loader2 size={20} className="animate-spin" />
        <span className="text-sm">Memuat data ODP…</span>
      </div>
    )
  }

  return (
    <div className="max-w-3xl mx-auto p-4 md:p-6 space-y-5 animate-fade-in">

      {/* Header */}
      <div className="flex items-center gap-3">
        <button onClick={() => navigate('/odp')}
          className="p-2 rounded-lg text-muted hover:text-primary hover:bg-[var(--bg-secondary)] border border-[var(--border)] transition-colors">
          <ArrowLeft size={16} />
        </button>
        <div>
          <h1 className="text-base font-bold text-primary">
            {isEdit ? `Edit ODP — ${odp?.name ?? ''}` : 'Tambah ODP Baru'}
          </h1>
          <p className="text-[10px] text-muted">Optical Distribution Point</p>
        </div>
      </div>

      {error && (
        <div className="flex items-center gap-2 px-4 py-3 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-400 text-sm">
          <AlertCircle size={15} /> {error}
        </div>
      )}

      <form onSubmit={handleSubmit} className="space-y-4">

        {/* ── Identitas ── */}
        <Section title="Identitas">
          <Field label="Nama ODP" required>
            <div className="flex gap-2">
              <input required value={form.name} onChange={e => set('name', e.target.value)}
                placeholder="ODP-OLT01-P1-RNGKT-01-A" className={IC + ' flex-1'} />
              <button type="button" onClick={handleSuggestName}
                title="Generate nama otomatis dari ODC"
                className="shrink-0 flex items-center gap-1.5 px-3 py-2 text-xs rounded-lg border border-[var(--accent)]/40 bg-[var(--accent-glow)] text-[var(--accent)] hover:bg-[var(--accent)]/20 transition-colors">
                <Wand2 size={13} />
                <span className="hidden sm:inline">Auto</span>
              </button>
            </div>
            <p className="text-[10px] text-muted mt-1">Format: ODP-[ODC]-[Huruf] &nbsp;·&nbsp; Pilih ODC untuk generate otomatis</p>
          </Field>

          <Field label="Alamat / Lokasi" hint="Terisi otomatis dari peta — bisa diedit manual">
            <input value={form.address} onChange={e => set('address', e.target.value)}
              placeholder="Akan terisi dari peta, atau isi manual…" className={IC} />
          </Field>

          <div className="grid grid-cols-2 gap-3">
            <Field label="Latitude">
              <input type="number" step="any" value={form.lat}
                onChange={e => set('lat', e.target.value)}
                placeholder="-7.257500" className={IC} />
            </Field>
            <Field label="Longitude">
              <input type="number" step="any" value={form.lng}
                onChange={e => set('lng', e.target.value)}
                placeholder="112.752100" className={IC} />
            </Field>
          </div>

          <button type="button" onClick={() => setMapOpen(true)}
            className="flex items-center gap-2 px-4 py-2.5 w-full rounded-lg border border-[var(--accent)]/40 bg-[var(--accent-glow)] text-[var(--accent)] text-sm hover:bg-[var(--accent)]/15 transition-colors">
            <MapPin size={15} />
            {form.lat && form.lng
              ? `📍 ${Number(form.lat).toFixed(5)}, ${Number(form.lng).toFixed(5)} — Klik untuk ubah`
              : 'Pilih Lokasi di Peta…'
            }
          </button>
        </Section>

        {/* ── Upstream ── */}
        <Section title="Upstream">
          {/* Uplink Type Selector */}
          <div className="flex gap-4 mb-4">
            <label className="flex items-center gap-2 cursor-pointer">
              <input
                type="radio"
                name="uplinkType"
                value="odc"
                checked={form.uplinkType === 'odc'}
                onChange={e => handleUplinkTypeChange(e.target.value)}
                className="accent-[var(--accent)]"
              />
              <span className="text-sm">Dari ODC</span>
            </label>
            <label className="flex items-center gap-2 cursor-pointer">
              <input
                type="radio"
                name="uplinkType"
                value="odp"
                checked={form.uplinkType === 'odp'}
                onChange={e => handleUplinkTypeChange(e.target.value)}
                className="accent-[var(--accent)]"
              />
              <span className="text-sm">Dari ODP Lain (Cascade)</span>
            </label>
          </div>

          {/* ODC Uplink */}
          {form.uplinkType === 'odc' && (
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <Field label="ODC Sumber" hint="OLT dan PON otomatis diisi dari ODC">
                <select value={form.odcId} onChange={e => handleOdcChange(e.target.value)} className={IC}>
                  <option value="">— Pilih ODC —</option>
                  {odcs.map(o => {
                    const avail = (o.capacity ?? 0) - (o.usedPorts ?? 0)
                    return (
                      <option key={o.id} value={o.id}>
                        {o.name}{avail > 0 ? ` (${avail} port)` : ' — Penuh'}
                      </option>
                    )
                  })}
                </select>
              </Field>
              <Field label="OLT" hint="Diambil otomatis dari ODC upstream (read-only)">
                <select value={form.oltId} disabled className={IC + ' opacity-60 cursor-not-allowed'}>
                  <option value="">{form.oltId ? olts.find(o => o.id === form.oltId)?.name || '—' : '— Pilih ODC —'}</option>
                </select>
              </Field>
              <Field label="PON Port" hint="Diambil otomatis dari ODC upstream (read-only)">
                <input
                  value={form.ponPort}
                  disabled
                  placeholder="—"
                  className={IC + ' opacity-60 cursor-not-allowed'}
                />
              </Field>
            </div>
          )}

          {/* ODP Cascade Uplink */}
          {form.uplinkType === 'odp' && (
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <Field label="ODP Upstream">
                <select
                  value={form.uplinkOdpId}
                  onChange={e => handleUplinkOdpChange(e.target.value)}
                  className={IC}
                >
                  <option value="">— Pilih ODP —</option>
                  {allOdps
                    .filter(o => o.id !== id) // exclude current ODP (edit mode)
                    .map(o => (
                      <option key={o.id} value={o.id}>
                        {o.name} {o.oltId && o.ponPort ? `(${o.ponPort})` : ''}
                      </option>
                    ))}
                </select>
              </Field>
              <Field label="Core dari ODP Upstream">
                <CoreSelect
                  value={form.uplinkOdpCore}
                  onChange={v => set('uplinkOdpCore', v)}
                />
              </Field>
              <Field label="OLT" hint="Diambil otomatis dari ODP upstream (read-only)">
                <select value={form.oltId} disabled className={IC + ' opacity-60 cursor-not-allowed'}>
                  <option value="">{form.oltId ? olts.find(o => o.id === form.oltId)?.name || '—' : '— Pilih ODP upstream —'}</option>
                </select>
              </Field>
              <Field label="PON Port" hint="Diambil otomatis dari ODP upstream (read-only)">
                <input
                  value={form.ponPort}
                  disabled
                  placeholder="—"
                  className={IC + ' opacity-60 cursor-not-allowed'}
                />
              </Field>
            </div>
          )}
        </Section>

        {/* ── Kabel Feeder ── */}
        <Section title="Kabel Feeder">
          <div className="grid grid-cols-2 gap-4">
            <Field label="Label Kabel">
              <input value={form.feederLabel} onChange={e => set('feederLabel', e.target.value)}
                placeholder={form.uplinkType === 'odc' ? 'FO-ODC01-ODP-A' : 'FO-ODP01-ODP02'}
                className={IC} />
            </Field>
            <Field label="Core Digunakan">
              <CoreSelect
                value={form.uplinkType === 'odc' ? form.feederCore : form.uplinkOdpCore}
                onChange={v => set(form.uplinkType === 'odc' ? 'feederCore' : 'uplinkOdpCore', v)}
              />
            </Field>
          </div>
        </Section>

        {/* ── Splitter System (NEW) ── */}
        <Section title="Splitter System">
          <SplitterManager
            splitters={form.splitters || []}
            onChange={(splitters) => set('splitters', splitters)}
            inputPower={form.inputPower}
            parentType="ODP"
          />
          {/* Legacy field - hidden but kept for backward compatibility */}
          <input type="hidden" value={form.splitterRatio} />
        </Section>

        {/* ── Info Fisik ── */}
        <Section title="Info Fisik">
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <Field label="Tipe Mounting">
              <select value={form.mountType} onChange={e => set('mountType', e.target.value)} className={IC}>
                <option value="">— Pilih —</option>
                {MOUNT_OPTIONS.map(m => <option key={m} value={m}>{m}</option>)}
              </select>
            </Field>
            <Field label="Brand">
              <input value={form.brand} onChange={e => set('brand', e.target.value)}
                placeholder="FiberHome, Huawei, …" className={IC} />
            </Field>
            <Field label="Status">
              <select value={form.status} onChange={e => set('status', e.target.value)} className={IC}>
                <option value="ACTIVE">Aktif</option>
                <option value="INACTIVE">Nonaktif / Cadangan</option>
                <option value="MAINTENANCE">Perbaikan</option>
              </select>
            </Field>
            <Field label="Tanggal Instalasi">
              <input type="date" value={form.installDate}
                onChange={e => set('installDate', e.target.value)} className={IC} />
            </Field>
            <Field label="PIC / Teknisi">
              <input value={form.pic} onChange={e => set('pic', e.target.value)}
                placeholder="Nama teknisi" className={IC} />
            </Field>
          </div>
          <Field label="Catatan">
            <textarea value={form.notes} onChange={e => set('notes', e.target.value)}
              rows={3} placeholder="Catatan tambahan…"
              className={IC + ' resize-none'} />
          </Field>
        </Section>

        {/* ── Foto Dokumentasi ── */}
        <Section title="Foto Dokumentasi">
          <PhotoUpload
            photos={form.photos}
            onChange={photos => set('photos', photos)}
            settings={{
              compression: settings?.photoCompression ?? true,
              quality: settings?.photoQuality ?? 80,
              maxSize: settings?.maxPhotoSize ?? 10,
            }}
          />
        </Section>

        {/* ── Footer ── */}
        <div className="flex gap-3 pt-2 pb-6">
          <Button type="button" variant="outline" size="md" onClick={() => navigate('/odp')}>
            Batal
          </Button>
          {isEdit && (
            <Button
              type="button"
              variant="outline"
              size="md"
              className="text-rose-400 hover:text-rose-500 border-rose-400/30"
              onClick={handleDeleteClick}
              icon={Trash2}
            >
              Hapus
            </Button>
          )}
          <Button
            type="submit"
            variant="primary"
            size="md"
            icon={saving ? Loader2 : Save}
            disabled={saving}
            className="flex-1 md:flex-none md:min-w-40"
          >
            {saving ? 'Menyimpan…' : isEdit ? 'Simpan Perubahan' : 'Tambah ODP'}
          </Button>
        </div>
      </form>

      {/* Confirm Modal */}
      <ConfirmModal
        isOpen={confirmOpen}
        onClose={() => setConfirmOpen(false)}
        onConfirm={confirmMode === 'delete' ? handleConfirmDelete : handleConfirmSubmit}
        title={confirmMode === 'delete' ? 'Hapus ODP' : isEdit ? 'Simpan Perubahan' : 'Tambah ODP'}
        message={
          confirmMode === 'delete'
            ? `Apakah Anda yakin ingin menghapus ODP "${form.name}"? Tindakan ini tidak dapat dibatalkan.`
            : isEdit
              ? `Simpan perubahan pada ODP "${form.name}"?`
              : `Tambah ODP baru "${form.name}"?`
        }
        confirmText={confirmMode === 'delete' ? 'Ya, Hapus' : 'Ya, Simpan'}
        cancelText="Batal"
        variant={confirmMode === 'delete' ? 'danger' : 'info'}
      />

      {mapOpen && (
        <LocationPickerModal
          lat={form.lat}
          lng={form.lng}
          onConfirm={() => setMapOpen(false)}
          onPositionChange={handlePositionChange}
          onAddressResolved={handleAddressResolved}
          onClose={() => setMapOpen(false)}
        />
      )}
    </div>
  )
}
