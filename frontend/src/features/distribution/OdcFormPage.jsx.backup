import React, { useState, useEffect, useMemo } from 'react'
import { useNavigate, useParams } from 'react-router-dom'
import { ArrowLeft, Loader2, AlertCircle, MapPin, Save, Wand2, Trash2 } from 'lucide-react'
import Button from '../../components/ui/Button'
import LocationPickerModal from '../../components/ui/LocationPickerModal'
import ConfirmModal from '../../components/ui/ConfirmModal'
import CoreSelect from './CoreSelect'
import PhotoUpload from './PhotoUpload'
import SplitterManager from './SplitterManager'
import { SPLITTER_OPTIONS, MOUNT_OPTIONS, useOdcList, useOdcDetail, createOdc, updateOdc, deleteOdc } from './useDistribution'
import { useDevices } from '../devices/useDevices'
import { useToast } from '../../context/ToastContext'
import { useAppSettings } from '../../hooks/useAppSettings'
import { suggestOdcName, getPonList } from './formHelpers'

const IC = 'w-full px-3 py-2 text-sm rounded-lg border border-[var(--border)] bg-[var(--bg-secondary)] text-primary placeholder:text-muted focus:outline-none focus:border-[var(--accent)] transition-colors'

function Section({ title, children }) {
  return (
    <div className="card p-5 space-y-4">
      <p className="text-xs font-semibold text-muted uppercase tracking-wider border-b border-[var(--border)] pb-2">{title}</p>
      {children}
    </div>
  )
}
function Field({ label, hint, children, required }) {
  return (
    <div>
      <label className="block text-xs font-medium text-secondary mb-1.5">
        {label}{required && <span className="text-rose-400 ml-0.5">*</span>}
      </label>
      {children}
      {hint && <p className="text-[10px] text-muted mt-1">{hint}</p>}
    </div>
  )
}

// Port selector for ODC uplink - shows all ports from upstream ODC, marks used ones
function PortSelect({ uplinkOdc, value, onChange, currentOdcId }) {
  const IC = 'w-full px-3 py-2 rounded-lg border border-[var(--border)] bg-[var(--bg-card)] text-sm focus:outline-none focus:ring-2 focus:ring-[var(--accent)]'
  
  // Generate port options based on upstream ODC cableCore
  const ports = useMemo(() => {
    if (!uplinkOdc) return []
    
    const totalCores = uplinkOdc.cableCore || uplinkOdc.cores?.length || 0
    const usedCores = uplinkOdc.cores || []
    
    return Array.from({ length: totalCores }, (_, i) => {
      const portNum = i + 1
      const coreData = usedCores.find(c => c.coreNo === portNum)
      const isUsedByOther = coreData?.usedBy && coreData.usedBy !== currentOdcId
      const isUsedByCurrent = coreData?.usedBy === currentOdcId
      
      return {
        portNum,
        isAvailable: !isUsedByOther,
        isUsedByCurrent,
        usedBy: coreData?.usedBy
      }
    })
  }, [uplinkOdc, currentOdcId])
  
  if (!uplinkOdc) {
    return (
      <select disabled className={IC + ' opacity-60 cursor-not-allowed'}>
        <option value="">— Pilih ODC upstream dulu —</option>
      </select>
    )
  }
  
  const hasAvailablePorts = ports.some(p => p.isAvailable)
  
  return (
    <select
      value={value || ''}
      onChange={e => onChange(e.target.value || null)}
      className={IC}
    >
      <option value="">— Pilih Port —</option>
      {ports.map(port => (
        <option
          key={port.portNum}
          value={String(port.portNum)}
          disabled={!port.isAvailable && !port.isUsedByCurrent}
          className={port.isAvailable || port.isUsedByCurrent ? '' : 'text-gray-400'}
        >
          Port {port.portNum}
          {port.isUsedByCurrent ? ' (digunakan)' : ''}
          {!port.isAvailable && !port.isUsedByCurrent ? ' (terpakai)' : ''}
        </option>
      ))}
      {!hasAvailablePorts && <option disabled>— Semua port terpakai —</option>}
    </select>
  )
}

const getEmptyState = (settings) => ({
  name: '', address: '', lat: '', lng: '',
  uplinkType: 'olt', // 'olt' | 'odc'
  oltId: '', ponPort: '',
  uplinkOdcId: '', uplinkCore: '',
  feederLabel: '', feederCores: '', feederCore: '',
  // NEW: Multi-splitter system
  splitters: [],
  inputPower: null,
  // Legacy fields (kept for backward compatibility)
  splitterRatio: settings?.defaultOdcSplitter ?? 'R1_8',
  passthrough: '',
  mountType: settings?.defaultMountType ?? '',
  brand: '', status: 'ACTIVE',
  installDate: '', pic: '', notes: '', photos: [],
})

export default function OdcFormPage() {
  const { id } = useParams()
  const navigate = useNavigate()
  const isEdit = Boolean(id)
  const toast = useToast()
  const { settings } = useAppSettings()

  const { devices } = useDevices()
  const olts = useMemo(() => devices.filter(d => d.type === 'olt' || d.type === 'OLT'), [devices])
  const { odc, loading: loadingOdc } = useOdcDetail(isEdit ? id : null)
  const { odcs: allOdcs } = useOdcList({})

  const [form, setForm]    = useState(() => getEmptyState(settings))
  const [saving, setSaving] = useState(false)
  const [error, setError]   = useState('')
  const [mapOpen, setMapOpen] = useState(false)
  const [confirmOpen, setConfirmOpen] = useState(false)
  const [confirmMode, setConfirmMode] = useState('save') // 'save' | 'delete'
  const [pendingPayload, setPendingPayload] = useState(null)

  // Reset form dengan default baru jika settings berubah (tambah mode)
  useEffect(() => {
    if (!isEdit) {
      setForm(f => ({ 
        ...f, 
        splitterRatio: settings?.defaultOdcSplitter ?? 'R1_8', 
        mountType: settings?.defaultMountType ?? '',
        splitters: [], // Reset splitters for new ODC
        inputPower: null,
      }))
    }
  }, [settings.defaultOdcSplitter, settings.defaultMountType, isEdit])

  const selectedOlt  = useMemo(() => olts.find(o => o.id === form.oltId) ?? null, [olts, form.oltId])
  const ponList      = useMemo(() => getPonList(selectedOlt), [selectedOlt])
  const existingNames = useMemo(() => allOdcs.filter(o => o.id !== id).map(o => o.name), [allOdcs, id])

  // Populate when editing
  useEffect(() => {
    if (isEdit && odc) {
      // Auto-migrate legacy splitterRatio to new splitters array if empty
      let migratedSplitters = odc.splitters ?? []
      if (migratedSplitters.length === 0 && odc.splitterRatio) {
        // Parse ratio like "R1_8" to get output count (8)
        const ratioMatch = odc.splitterRatio.match(/R1_(\d+)/)
        const outputCount = ratioMatch ? parseInt(ratioMatch[1]) : 8
        const ratioLabel = ratioMatch ? `1:${ratioMatch[1]}` : '1:8'
        
        migratedSplitters = [{
          id: `legacy-${Date.now()}`,
          splitterTypeId: odc.splitterRatio,
          category: 'SYMMETRIC',
          sequenceOrder: 1,
          position: 'Slot A',
          portMappings: [],
          inputPower: null,
          outputs: outputCount,
          type: {
            id: odc.splitterRatio,
            code: odc.splitterRatio,
            name: `PLC ${ratioLabel}`,
            category: 'SYMMETRIC',
            outputCount: outputCount,
            attEqual: parseFloat((3.5 + 10 * Math.log10(outputCount)).toFixed(1))
          }
        }]
      }
      
      setForm({
        name:          odc.name          ?? '',
        address:       odc.address       ?? '',
        lat:           odc.lat           ?? '',
        lng:           odc.lng           ?? '',
        uplinkType:    odc.uplinkType    ?? 'olt',
        oltId:         odc.oltId         ?? '',
        ponPort:       odc.ponPort       ?? '',
        uplinkOdcId:   odc.uplinkOdcId   ?? '',
        uplinkCore:    odc.uplinkCore    ?? '',
        feederLabel:   odc.feederLabel   ?? '',
        feederCores:   odc.feederCores   ?? '',
        feederCore:    odc.feederCore    ?? '',
        splitterRatio: odc.splitterRatio ?? 'R1_8',
        passthrough:   odc.passthrough   ?? '',
        mountType:     odc.mountType     ?? '',
        brand:         odc.brand         ?? '',
        status:        odc.status        ?? 'ACTIVE',
        installDate:   odc.installDate ? odc.installDate.slice(0, 10) : '',
        pic:           odc.pic           ?? '',
        notes:         odc.notes         ?? '',
        photos:        odc.photos        ?? [],
        // NEW: Multi-splitter fields from API (or migrated from legacy)
        splitters:     migratedSplitters,
        inputPower:    odc.inputPower    ?? null,
      })
    }
  }, [isEdit, odc])

  const set = (k, v) => setForm(f => ({ ...f, [k]: v }))

  // Uplink type change
  const handleUplinkTypeChange = (type) => {
    setForm(f => ({
      ...f,
      uplinkType: type,
      oltId: '', ponPort: '',
      uplinkOdcId: '', uplinkCore: '',
    }))
  }

  // OLT change → reset PON, re-suggest name
  const handleOltChange = (oltId) => {
    const olt = olts.find(o => o.id === oltId)
    setForm(f => ({
      ...f, oltId, ponPort: '',
      name: !isEdit
        ? suggestOdcName({ oltName: olt?.name, ponPort: '', address: f.address, existingNames })
        : f.name,
    }))
  }

  // Uplink ODC change → inherit OLT/PON from upstream ODC
  const handleUplinkOdcChange = (odcId) => {
    const uplinkOdc = allOdcs.find(o => o.id === odcId)
    setForm(f => ({
      ...f,
      uplinkOdcId: odcId,
      uplinkCore: '',
      // Auto-inherit OLT and PON from upstream ODC (read-only in UI)
      oltId: uplinkOdc?.oltId ?? '',
      ponPort: uplinkOdc?.ponPort ?? '',
      name: !isEdit
        ? suggestOdcName({ oltName: uplinkOdc?.olt?.name || uplinkOdc?.name, ponPort: uplinkOdc?.ponPort || '', address: f.address, existingNames })
        : f.name,
    }))
  }

  // PON change → re-suggest name
  const handlePonChange = (ponPort) => {
    setForm(f => {
      const olt = olts.find(o => o.id === f.oltId)
      return {
        ...f, ponPort,
        name: !isEdit
          ? suggestOdcName({ oltName: olt?.name, ponPort, address: f.address, existingNames })
          : f.name,
      }
    })
  }

  // Manual generate button
  const handleSuggestName = () => {
    const olt = olts.find(o => o.id === form.oltId)
    set('name', suggestOdcName({ oltName: olt?.name, ponPort: form.ponPort, address: form.address, existingNames }))
  }

  // Real-time update saat marker digeser / klik peta / GPS
  const handlePositionChange = ({ lat, lng }) => setForm(f => ({ ...f, lat, lng }))

  // Reverse geocode → selalu update alamat ke hasil terbaru
  const handleAddressResolved = (address) => setForm(f => ({ ...f, address }))

  const handleSubmit = (e) => {
    e.preventDefault()
    setConfirmMode('save')
    
    // Derive legacy splitterRatio from first splitter if exists (for backward compatibility)
    const firstSplitter = form.splitters?.[0]
    const derivedSplitterRatio = firstSplitter 
      ? `R1_${firstSplitter.type?.outputCount || firstSplitter.outputs || 8}`
      : form.splitterRatio
    
    const payload = {
      ...form,
      lat:         form.lat         !== '' ? Number(form.lat)         : null,
      lng:         form.lng         !== '' ? Number(form.lng)         : null,
      feederCores: form.feederCores !== '' ? Number(form.feederCores) : null,
      passthrough: form.passthrough !== '' ? Number(form.passthrough) : null,
      oltId:       form.oltId   || null,
      ponPort:     form.ponPort || null,
      uplinkOdcId: form.uplinkType === 'odc' ? (form.uplinkOdcId || null) : null,
      uplinkCore:  form.uplinkType === 'odc' ? (form.uplinkCore || null) : null,
      installDate: form.installDate || null,
      photos:      form.photos?.length ? form.photos : null,
      // NEW: Multi-splitter fields
      splitters:   form.splitters?.length ? form.splitters : null,
      inputPower:  form.inputPower !== '' ? (form.inputPower !== null ? Number(form.inputPower) : null) : null,
      // Legacy: derive from new splitters for backward compatibility
      splitterRatio: derivedSplitterRatio,
    }
    setPendingPayload(payload)
    setConfirmOpen(true)
  }

  const handleConfirmSubmit = async () => {
    if (!pendingPayload) return
    setConfirmOpen(false)
    setSaving(true)
    setError('')
    try {
      if (isEdit) {
        await updateOdc(id, pendingPayload)
        toast.success(`ODC "${pendingPayload.name}" berhasil diperbarui`)
      } else {
        await createOdc(pendingPayload)
        toast.success(`ODC "${pendingPayload.name}" berhasil ditambahkan`)
      }
      navigate('/odc')
    } catch (e) {
      const msg = e.message ?? 'Gagal menyimpan'
      setError(msg)
      toast.error(msg)
    } finally {
      setSaving(false)
      setPendingPayload(null)
    }
  }

  const handleDeleteClick = () => {
    setConfirmMode('delete')
    setConfirmOpen(true)
  }

  const handleConfirmDelete = async () => {
    if (!id) return
    setConfirmOpen(false)
    try {
      await deleteOdc(id)
      toast.success(`ODC berhasil dihapus`)
      navigate('/odc')
    } catch (e) {
      const msg = e.message ?? 'Gagal menghapus'
      toast.error(msg)
    }
  }

  if (isEdit && loadingOdc) {
    return (
      <div className="flex items-center justify-center py-24 text-muted gap-3">
        <Loader2 size={20} className="animate-spin" />
        <span className="text-sm">Memuat data ODC…</span>
      </div>
    )
  }

  return (
    <div className="max-w-3xl mx-auto p-4 md:p-6 space-y-5 animate-fade-in">

      {/* Header */}
      <div className="flex items-center gap-3">
        <button onClick={() => navigate('/odc')}
          className="p-2 rounded-lg text-muted hover:text-primary hover:bg-[var(--bg-secondary)] border border-[var(--border)] transition-colors">
          <ArrowLeft size={16} />
        </button>
        <div>
          <h1 className="text-base font-bold text-primary">
            {isEdit ? `Edit ODC — ${odc?.name ?? ''}` : 'Tambah ODC Baru'}
          </h1>
          <p className="text-[10px] text-muted">Optical Distribution Cabinet</p>
        </div>
      </div>

      {error && (
        <div className="flex items-center gap-2 px-4 py-3 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-400 text-sm">
          <AlertCircle size={15} /> {error}
        </div>
      )}

      <form onSubmit={handleSubmit} className="space-y-4">

        {/* ── Identitas ── */}
        <Section title="Identitas">
          <Field label="Nama ODC" required>
            <div className="flex gap-2">
              <input required value={form.name} onChange={e => set('name', e.target.value)}
                placeholder="ODC-01-P1-JBG-001" className={IC + ' flex-1'} />
              <button type="button" onClick={handleSuggestName}
                title="Generate nama otomatis dari OLT, PON, dan lokasi"
                className="shrink-0 flex items-center gap-1.5 px-3 py-2 text-xs rounded-lg border border-[var(--accent)]/40 bg-[var(--accent-glow)] text-[var(--accent)] hover:bg-[var(--accent)]/20 transition-colors">
                <Wand2 size={13} />
                <span className="hidden sm:inline">Auto</span>
              </button>
            </div>
            <p className="text-[10px] text-muted mt-1">Format: ODC-[OLT]-[PON]-[LOKASI]-[No] &nbsp;·&nbsp; Pilih OLT &amp; PON dulu agar nama ter-generate otomatis</p>
          </Field>

          <Field label="Alamat / Lokasi" hint="Terisi otomatis saat memilih lokasi di peta — bisa diedit manual">
            <input value={form.address} onChange={e => set('address', e.target.value)}
              placeholder="Akan terisi dari peta, atau isi manual…" className={IC} />
          </Field>

          <div className="grid grid-cols-2 gap-3">
            <Field label="Latitude">
              <input type="number" step="any" value={form.lat}
                onChange={e => set('lat', e.target.value)}
                placeholder="-7.257500" className={IC} />
            </Field>
            <Field label="Longitude">
              <input type="number" step="any" value={form.lng}
                onChange={e => set('lng', e.target.value)}
                placeholder="112.752100" className={IC} />
            </Field>
          </div>

          <button type="button" onClick={() => setMapOpen(true)}
            className="flex items-center gap-2 px-4 py-2.5 w-full rounded-lg border border-[var(--accent)]/40 bg-[var(--accent-glow)] text-[var(--accent)] text-sm hover:bg-[var(--accent)]/15 transition-colors">
            <MapPin size={15} />
            {form.lat && form.lng
              ? `📍 ${Number(form.lat).toFixed(5)}, ${Number(form.lng).toFixed(5)} — Klik untuk ubah`
              : 'Pilih Lokasi di Peta…'
            }
          </button>
        </Section>

        {/* ── Upstream ── */}
        <Section title="Sumber Upstream">
          {/* Uplink Type Selector */}
          <div className="flex gap-4 mb-4">
            <label className="flex items-center gap-2 cursor-pointer">
              <input
                type="radio"
                name="uplinkType"
                value="olt"
                checked={form.uplinkType === 'olt'}
                onChange={e => handleUplinkTypeChange(e.target.value)}
                className="accent-[var(--accent)]"
              />
              <span className="text-sm">Dari OLT</span>
            </label>
            <label className="flex items-center gap-2 cursor-pointer">
              <input
                type="radio"
                name="uplinkType"
                value="odc"
                checked={form.uplinkType === 'odc'}
                onChange={e => handleUplinkTypeChange(e.target.value)}
                className="accent-[var(--accent)]"
              />
              <span className="text-sm">Dari ODC Lain</span>
            </label>
          </div>

          {/* OLT Uplink */}
          {form.uplinkType === 'olt' && (
            <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <Field label="OLT">
                <select value={form.oltId} onChange={e => handleOltChange(e.target.value)} className={IC}>
                  <option value="">— Pilih OLT —</option>
                  {olts.map(o => <option key={o.id} value={o.id}>{o.name}</option>)}
                </select>
              </Field>
              <Field label="PON Port" hint={!form.oltId ? 'Pilih OLT dahulu untuk menampilkan daftar PON' : undefined}>
                {ponList.length > 0 ? (
                  <select value={form.ponPort} onChange={e => handlePonChange(e.target.value)} className={IC}>
                    <option value="">— Pilih PON —</option>
                    {ponList.map(p => <option key={p.value} value={p.value}>{p.label}</option>)}
                  </select>
                ) : (
                  <input value={form.ponPort} onChange={e => handlePonChange(e.target.value)}
                    placeholder={form.oltId ? 'PON1, PON2, …' : '— Pilih OLT dahulu —'}
                    disabled={!form.oltId}
                    className={IC + (!form.oltId ? ' opacity-50 cursor-not-allowed' : '')} />
                )}
              </Field>
              <Field label="Power Input OLT" hint="Dalam dBm (opsional, untuk kalkulasi)">
                <div className="relative">
                  <input 
                    type="number" 
                    step="0.1"
                    value={form.inputPower !== null ? form.inputPower : ''}
                    onChange={e => set('inputPower', e.target.value !== '' ? parseFloat(e.target.value) : null)}
                    placeholder="+4.0"
                    className={IC}
                  />
                  <span className="absolute right-3 top-1/2 -translate-y-1/2 text-xs text-muted">dBm</span>
                </div>
              </Field>
            </div>
          )}

          {/* ODC Uplink */}
          {form.uplinkType === 'odc' && (
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <Field label="ODC Upstream">
                <select
                  value={form.uplinkOdcId}
                  onChange={e => handleUplinkOdcChange(e.target.value)}
                  className={IC}
                >
                  <option value="">— Pilih ODC —</option>
                  {allOdcs
                    .filter(o => o.id !== id) // exclude current ODC (edit mode)
                    .map(o => (
                      <option key={o.id} value={o.id}>{o.name}</option>
                    ))}
                </select>
              </Field>
              <Field label="Port dari ODC Upstream">
                <PortSelect
                  uplinkOdc={allOdcs.find(o => o.id === form.uplinkOdcId)}
                  value={form.uplinkCore}
                  onChange={v => set('uplinkCore', v)}
                  currentOdcId={id}
                />
              </Field>
              <Field label="OLT" hint="Diambil otomatis dari ODC upstream (read-only)">
                <select value={form.oltId} disabled className={IC + ' opacity-60 cursor-not-allowed'}>
                  <option value="">{form.oltId ? olts.find(o => o.id === form.oltId)?.name || '—' : '— Pilih ODC upstream —'}</option>
                </select>
              </Field>
              <Field label="PON Port" hint="Diambil otomatis dari ODC upstream (read-only)">
                <input
                  value={form.ponPort}
                  disabled
                  placeholder="—"
                  className={IC + ' opacity-60 cursor-not-allowed'}
                />
              </Field>
            </div>
          )}
        </Section>

        {/* ── Kabel Feeder ── */}
        <Section title="Kabel Feeder (Masuk)">
          <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <Field label="Label Kabel">
              <input value={form.feederLabel} onChange={e => set('feederLabel', e.target.value)}
                placeholder="FO-OLT-ODC01" className={IC} />
            </Field>
            <Field label="Jumlah Core">
              <input type="number" min="1" value={form.feederCores}
                onChange={e => set('feederCores', e.target.value)}
                placeholder="12" className={IC} />
            </Field>
            <Field label="Core Digunakan">
              <CoreSelect value={form.feederCore} onChange={v => set('feederCore', v)} />
            </Field>
          </div>
        </Section>

        {/* ── Splitter System (NEW) ── */}
        <Section title="Splitter System">
          <SplitterManager
            splitters={form.splitters || []}
            onChange={(splitters) => set('splitters', splitters)}
            inputPower={form.inputPower}
            parentType="ODC"
          />
          
          {/* Legacy field - hidden but kept for backward compatibility */}
          <input type="hidden" value={form.splitterRatio} />
        </Section>

        {/* ── Info Fisik ── */}
        <Section title="Info Fisik & Administrasi">
          <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <Field label="Tipe Mounting">
              <select value={form.mountType} onChange={e => set('mountType', e.target.value)} className={IC}>
                <option value="">— Pilih —</option>
                {MOUNT_OPTIONS.map(m => <option key={m} value={m}>{m}</option>)}
              </select>
            </Field>
            <Field label="Merk / Brand">
              <input value={form.brand} onChange={e => set('brand', e.target.value)}
                placeholder="CommScope, Corning, …" className={IC} />
            </Field>
            <Field label="Status">
              <select value={form.status} onChange={e => set('status', e.target.value)} className={IC}>
                <option value="ACTIVE">Aktif</option>
                <option value="INACTIVE">Nonaktif / Cadangan</option>
                <option value="MAINTENANCE">Perbaikan</option>
              </select>
            </Field>
            <Field label="Tanggal Instalasi">
              <input type="date" value={form.installDate}
                onChange={e => set('installDate', e.target.value)} className={IC} />
            </Field>
            <Field label="PIC / Teknisi">
              <input value={form.pic} onChange={e => set('pic', e.target.value)}
                placeholder="Nama teknisi penanggung jawab" className={IC} />
            </Field>
          </div>
          <Field label="Catatan">
            <textarea value={form.notes} onChange={e => set('notes', e.target.value)}
              rows={3} placeholder="Catatan tambahan tentang ODC ini…"
              className={IC + ' resize-none'} />
          </Field>
        </Section>

        {/* ── Foto Dokumentasi ── */}
        <Section title="Foto Dokumentasi">
          <PhotoUpload
            photos={form.photos}
            onChange={photos => set('photos', photos)}
            settings={{
              compression: settings?.photoCompression ?? true,
              quality: settings?.photoQuality ?? 80,
              maxSize: settings?.maxPhotoSize ?? 10,
            }}
          />
        </Section>

        {/* ── Footer ── */}
        <div className="flex gap-3 pt-2 pb-6">
          <Button type="button" variant="outline" size="md" onClick={() => navigate('/odc')}>
            Batal
          </Button>
          {isEdit && (
            <Button
              type="button"
              variant="outline"
              size="md"
              className="text-rose-400 hover:text-rose-500 border-rose-400/30"
              onClick={handleDeleteClick}
              icon={Trash2}
            >
              Hapus
            </Button>
          )}
          <Button
            type="submit"
            variant="primary"
            size="md"
            icon={saving ? Loader2 : Save}
            disabled={saving}
            className="flex-1 md:flex-none md:min-w-40"
          >
            {saving ? 'Menyimpan…' : isEdit ? 'Simpan Perubahan' : 'Tambah ODC'}
          </Button>
        </div>
      </form>

      {/* Confirm Modal */}
      <ConfirmModal
        isOpen={confirmOpen}
        onClose={() => setConfirmOpen(false)}
        onConfirm={confirmMode === 'delete' ? handleConfirmDelete : handleConfirmSubmit}
        title={confirmMode === 'delete' ? 'Hapus ODC' : isEdit ? 'Simpan Perubahan' : 'Tambah ODC'}
        message={
          confirmMode === 'delete'
            ? `Apakah Anda yakin ingin menghapus ODC "${form.name}"? Tindakan ini tidak dapat dibatalkan.`
            : isEdit
              ? `Simpan perubahan pada ODC "${form.name}"?`
              : `Tambah ODC baru "${form.name}"?`
        }
        confirmText={confirmMode === 'delete' ? 'Ya, Hapus' : 'Ya, Simpan'}
        cancelText="Batal"
        variant={confirmMode === 'delete' ? 'danger' : 'info'}
      />

      {mapOpen && (
        <LocationPickerModal
          lat={form.lat}
          lng={form.lng}
          onConfirm={() => setMapOpen(false)}
          onPositionChange={handlePositionChange}
          onAddressResolved={handleAddressResolved}
          onClose={() => setMapOpen(false)}
        />
      )}
    </div>
  )
}
